# syntax=docker/dockerfile:1.7
#
# paperless-ngx + paperless-paddleocr (classic-gpu engine).
# Runs the classic PaddleOCR CNN pipeline locally on an NVIDIA GPU exposed
# via nvidia-container-toolkit.
#
# Build:
#   docker build \
#     --build-arg PLUGIN_REF=v0.1.1 \
#     --build-arg CUDA_WHEEL=cu126 \
#     -f examples/Dockerfile.classic-gpu \
#     -t paperless-paddleocr:classic-gpu .
#
# CUDA_WHEEL - Paddle GPU wheel index:
#   cu126 (default) - CUDA 12.6, Ampere / Ada / Hopper.
#   cu129           - CUDA 12.9, Blackwell (RTX 50-series, sm_120).

ARG PLUGIN_REF=master
ARG PAPERLESS_TAG=latest
ARG CUDA_WHEEL=cu126

# --- Stage 1: build the plugin wheel from source --------------------------
FROM python:3.13-slim AS plugin
ARG PLUGIN_REF
ADD https://github.com/flobernd/paperless-paddleocr.git#${PLUGIN_REF} /src
WORKDIR /src
RUN pip install --no-cache-dir build \
 && python -m build --wheel --outdir /dist

# --- Stage 2: layer the GPU worker venv + CUDA runtime libs + the plugin ---
FROM ghcr.io/paperless-ngx/paperless-ngx:${PAPERLESS_TAG}
ARG CUDA_WHEEL

# OpenCV native libs plus the CUDA-12 user-space runtime libraries
# (cuDNN, NCCL) that paddlepaddle-gpu links against.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg \
 && curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/3bf863cc.pub \
      | gpg --dearmor -o /usr/share/keyrings/nvidia-cuda.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/nvidia-cuda.gpg] https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/ /" \
      > /etc/apt/sources.list.d/nvidia-cuda.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      libgl1 \
      libglib2.0-0 \
      libsm6 \
      libxext6 \
      libxrender1 \
      libgomp1 \
      libcudnn9-cuda-12 \
      libnccl2 \
 && apt-get purge -y curl gnupg \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# The base image ships uv too, at a version that varies with the tag.
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /usr/local/bin/

# PaddlePaddle supports no Python newer than 3.13, and the paperless-ngx 3.1
# and later images run 3.14, so PaddlePaddle gets a venv of its own at the
# path the plugin looks for. uv would install the interpreter under /root,
# which the paperless user that runs the Celery workers cannot traverse.
# paddlepaddle-gpu comes from Baidu's index, which carries no paddleocr
# release, so paddleocr follows from PyPI in a second install.
ENV UV_PYTHON_INSTALL_DIR=/opt/paperless-paddleocr/python
COPY --from=plugin /src/paddle-requirements-gpu.txt /tmp/plugin/
RUN uv python install 3.13 \
 && uv venv --python 3.13 /opt/paperless-paddleocr/venv \
 && uv pip install --no-cache --python /opt/paperless-paddleocr/venv/bin/python \
      --index-url "https://www.paddlepaddle.org.cn/packages/stable/${CUDA_WHEEL}/" \
      "paddlepaddle-gpu>=3.0,<4" \
 && uv pip install --no-cache --python /opt/paperless-paddleocr/venv/bin/python \
      -r /tmp/plugin/paddle-requirements-gpu.txt \
 && chmod -R a+rX /opt/paperless-paddleocr

# The plugin goes into the interpreter that runs paperless. The paperless
# user, which runs the Celery workers and with them the paddle worker,
# downloads the models into its ~/.paddlex, and a new named volume mounted
# there takes the ownership of the image's directory.
COPY --from=plugin /dist/*.whl /tmp/plugin/
RUN PY=$([ -x /usr/src/paperless/.venv/bin/python ] && echo /usr/src/paperless/.venv/bin/python || command -v python3) \
 && "$PY" -m pip install --no-cache-dir /tmp/plugin/*.whl \
 && rm -rf /tmp/plugin \
 && install -d -o paperless -g paperless /usr/src/paperless/.paddlex

ENV PAPERLESS_PADDLEOCR_ENGINE=classic-gpu
